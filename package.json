{
  "name": "ai-file-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Permission-aware document workspaces for collaborative AI agents",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "dev": "concurrently -k npm:dev:api npm:dev:web",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/server/src/index.ts",
    "dev:web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config apps/web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/apps/server/src/index.js",
    "cli": "node --env-file-if-exists=.env --import tsx packages/cli/src/index.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx packages/mcp/src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "build:api": "tsc",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "check": "npm run typecheck && npm test && npm run build",
    "language-check": "node scripts/check-language.mjs",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "example": "node --env-file-if-exists=.env --import tsx examples/two-agents.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^10.1.7",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
